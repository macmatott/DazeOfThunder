# ── Discord bot ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=

# ── Supabase (shared by frontend + backend + bot) ───────────
# Public values — safe in frontend code:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only — NEVER expose in frontend or Discord bot output:
SUPABASE_SERVICE_ROLE_KEY=

# ── External F1 data source ─────────────────────────────────
# Jolpica-F1 — Ergast-compatible, free, no auth
F1_DATA_API_BASE_URL=https://api.jolpi.ca/ergast/f1

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Signs the session cookie (Discord sign-in) — a random value, not a
# Supabase key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
